NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pwani_ride
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=0
COMMISSION_RATE=0.2

# Dev only: fixed OTP so you can log in without an SMS provider
OTP_DEV_CODE=123456

# M-Pesa Daraja. Leave the key empty in development to use the built-in mock.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_TOKEN=change-me-callback

# Africa's Talking SMS (optional in development, SMS is logged to the console)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Used by `npm run seed`
ADMIN_EMAIL=admin@pwaniride.test
ADMIN_PASSWORD=ChangeMe123!
ADMIN_PHONE=254700000000

# Photo uploads (local disk). Use a persistent volume in production.
UPLOAD_DIR=./uploads
# Optional: Expo push access token (enable "enhanced security" in your Expo account to require it)
EXPO_ACCESS_TOKEN=

# Driving routes on the map and road-distance fares. OSRM public server is for testing only (self-host for production).
ROUTING_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org
GOOGLE_MAPS_SERVER_KEY=

# Card payments (Paystack hosted checkout). Empty in development = mock. Webhook URL to register with Paystack:
#   {PUBLIC_URL}/api/payments/card/webhook
PAYSTACK_SECRET_KEY=
PAYMENT_EMAIL_DOMAIN=pwaniride.app

# Weekly driver payouts by M-Pesa B2C (needs a Daraja B2C-enabled shortcode and Safaricom's public certificate file)
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
MPESA_CERT_PATH=
PAYOUT_MIN=100
SUBSCRIPTION_TRIP_PAY=150

# Camera footage
FOOTAGE_DIR=./footage
FOOTAGE_RETENTION_DAYS=30
FOOTAGE_SIGN_SECRET=change-me-footage
