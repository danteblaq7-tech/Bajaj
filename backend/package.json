{
  "name": "pwani-ride-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for the Pwani Ride tuktuk ride-hailing MVP (Node.js + Express + PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
